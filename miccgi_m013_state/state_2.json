  "source": "import math\ndef dr_ae397fb044d3(previous_target,current_target,current_exogenous):\n    cur=(float(current_target)-(59.97388765467834))/(23.986428736813075)\n    prev=(float(previous_target)-(59.97388765467834))/(23.986428736813075)\n    exo=(float(current_exogenous)-(2.769574688940092))/(1.4024271753848487)\n    trend=cur-prev\n    name='trend_interaction'\n    if name=='trend': x=[1.0,cur,trend]\n    elif name=='exo': x=[1.0,cur,exo]\n    elif name=='trend_exo': x=[1.0,cur,trend,exo]\n    elif name=='trend_tanh_exo': x=[1.0,cur,trend,math.tanh(exo)]\n    elif name=='trend_interaction': x=[1.0,cur,trend,exo,trend*exo]\n    else: raise ValueError(name)\n    c=[0.0016784795355454783, 0.9988645187426641, 0.8328694013320614, -0.0005326339967470204, 0.050805361437219684]\n    z=sum(a*b for a,b in zip(c,x))\n    return z*(23.986428736813075)+(59.97388765467834)\n",
